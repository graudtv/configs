.groups:
  essential: &groups.essential
    - git
    - lsb-release
    - vim
    - wget
  drivers: &groups.drivers
    - sof-firmware
  system: &groups.system
    - networkmanager
    - usbutils
  dev: &groups.dev
    - base-devel
    - clang
    - cmake
    - ninja
    - nvm
    - python-pip
    - python-yaml
  cli: &groups.cli
    - bash-completion
    - curl
    - fastfetch
    - fzf
    - git-lfs
    - man-db
    - man-pages
    - ncdu
    - neovim
    - nmon
    - openssh
    - rsync
    - texinfo
    - tldr
    - tmux
    - traceroute
    - tree
    - unzip
    - yay:ack
    - zoxide
  cliExtra: &groups.cli-extra
    - pass
  guiShell: &groups.gui-shell
    - brightnessctl
    - fuzzel
    - greetd
    - libnotify
    - mako
    - niri
    - noctalia
    - noto-fonts
    - noto-fonts-emoji
    - pipewire
    - playerctl
    - polkit-gnome
    - qt6-multimedia-ffmpeg
    - qt6-wayland
    - swayidle
    - ttf-noto-nerd
    - xdg-desktop-portal-gtk
    - yay:noctalia-greeter
    - yay:swaylock-effects
    - yay:wlogout
  guiTools: &groups.gui-tools
    - alacritty
    - dolphin
    - firefox
    - gnome-keyring
    - gparted
    - imv
    - kitty
    - nautilus
    - seahorse
    - sushi
    - wev
  guiToolsExtra: &groups.gui-tools-extra
    - hunspell
    - hunspell-en_us
    - hunspell-ru
    - libreoffice-still
    - vlc
  openconnect: &groups.openconnect
    - network-manager-applet
    - networkmanager-openconnect
    - openconnect

{{- if eq .preset "work-pc-arch" }}
pacman:
  - *groups.essential
  - *groups.drivers
  - *groups.system
  - *groups.dev
  - *groups.cli
  - *groups.cli-extra
  - *groups.gui-shell
  - *groups.gui-tools
  - *groups.gui-tools-extra
  - *groups.openconnect
{{- end }}

# vim: ft=yaml
