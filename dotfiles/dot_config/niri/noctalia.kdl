layout {

    focus-ring {
        active-color   "#d7bafb"
        inactive-color "#151218"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d7bafb"
        inactive-color "#151218"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d7bafb"
        inactive-color "#533b72"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d7bafb80"
    }
}

recent-windows {
    highlight {
        active-color "#d7bafb"
        urgent-color "#ffb4ab"
    }
}
